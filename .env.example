# Copy to .env at the repo root. All values are local-only POC defaults, not secrets.

# Models
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=phi4-mini
LLM_TOOL_MODE=json              # json (schema-constrained, default) | native (OpenAI tool_calls)
ASR_BACKEND=whisper             # whisper | parakeet (parakeet not bundled, see docs/DECISIONS.md)
WHISPER_MODEL=small.en
TTS_BACKEND=kokoro
KOKORO_VOICE=af_heart
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
ROUTER_HIGH=0.80
ROUTER_FAQ=0.60

# Model storage and offline enforcement
MODELS_DIR=../../models
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Services
BACKEND_API_URL=http://localhost:8001
PAYMENT_SERVICE_URL=http://localhost:8002
VOICE_AGENT_URL=http://localhost:7860
WEB_ORIGIN=http://localhost:5173

# Payment capture
CAPTURE_TIMEOUT_SECONDS=120

# Security (POC values, not secrets)
WEBHOOK_HMAC_SECRET=dev-only-change-me

# Debug: raw audio is never written unless this is 1, and it is paused during SECURE_CAPTURE
RECORD_AUDIO=0
